---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Regua from '../../components/Regua.astro';
import CardImovel from '../../components/CardImovel.astro';
import { listarImoveis, brl, m2, TIPO, STATUS, comparaBairro, wa, u, dadosBairro } from '../../lib/imoveis.js';
import site from '../../data/site.json';

export async function getStaticPaths() {
  const imoveis = await listarImoveis();
  return imoveis.map((imovel) => ({ params: { id: imovel.id }, props: { imovel, todos: imoveis } }));
}
const { imovel, todos } = Astro.props;
const d = imovel.data;
const { Content } = await render(imovel);
const c = comparaBairro(d);
const b = dadosBairro(d.bairro);
const og = await getImage({ src: d.fotos[0], width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const mensal = (d.condominio_mensal ?? 0) + (d.iptu_anual ? d.iptu_anual / 12 : 0);
const rotuloMensal = d.condominio_mensal && d.iptu_anual ? 'de condomínio e IPTU' : d.condominio_mensal ? 'de condomínio' : 'de IPTU';
const raiz = Astro.site ?? new URL(site.url);
const url = new URL(u(`/imoveis/${imovel.id}/`), raiz).href;
const msgVisita = `Olá! Quero visitar o imóvel ${d.codigo} (${d.titulo}, ${d.bairro}). ${url}`;
const msgDuvida = `Olá! Tenho uma dúvida sobre o imóvel ${d.codigo} (${d.titulo}): `;
const ehTerreno = d.tipo === 'terreno' || d.tipo === 'chacara';
const desc = `${TIPO[d.tipo]} à venda no ${d.bairro}, São João da Boa Vista. ${brl(d.preco)}${!ehTerreno && d.area_construida ? ` · ${m2(d.area_construida)}` : d.area_terreno ? ` · ${m2(d.area_terreno)}` : ''}${d.quartos ? ` · ${d.quartos} ${d.quartos === 1 ? 'quarto' : 'quartos'}` : ''}.`;
const tipoSchema = { casa: 'House', apartamento: 'Apartment', terreno: 'Place', chacara: 'House', comercial: 'Place' }[d.tipo];
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'RealEstateListing', name: d.titulo, url, description: desc, image: new URL(og.src, raiz).href,
      offers: { '@type': 'Offer', price: d.preco, priceCurrency: 'BRL', availability: d.status === 'vendido' ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock' },
      about: { '@type': tipoSchema, name: d.titulo, floorSize: d.area_construida ? { '@type': 'QuantitativeValue', value: d.area_construida, unitCode: 'MTK' } : undefined, numberOfRooms: d.quartos ?? undefined, address: { '@type': 'PostalAddress', addressLocality: 'São João da Boa Vista', addressRegion: 'SP', addressCountry: 'BR' } } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Imóveis', item: new URL(u('/imoveis/'), raiz).href },
      ...(b ? [{ '@type': 'ListItem', position: 2, name: b.nome, item: new URL(u(`/bairros/${b.slug}/`), raiz).href }] : []),
      { '@type': 'ListItem', position: b ? 3 : 2, name: d.titulo, item: url },
    ] },
  ],
};
const rotuloDif = c ? (c.dif <= -0.02 ? `Está ${Math.round(-c.dif * 100)}% abaixo da mediana.` : c.dif >= 0.02 ? `Está ${Math.round(c.dif * 100)}% acima da mediana.` : 'Está na mediana.') : '';
const corDif = c ? (c.dif <= -0.02 ? 'var(--ok)' : c.dif >= 0.02 ? 'var(--warn)' : 'var(--ink)') : '';
const grupos = [['area_externa', 'Área externa'], ['comodos', 'Cômodos'], ['facilidades', 'Facilidades'], ['diferenciais', 'Diferenciais']]
  .map(([k, t]) => [t, d.caracteristicas?.[k] ?? []]).filter(([, xs]) => xs.length);
const vizinhos = todos.filter((i) => i.id !== imovel.id && i.data.bairro === d.bairro).slice(0, 3);
const outros = vizinhos.length ? vizinhos : todos.filter((i) => i.id !== imovel.id && i.data.tipo === d.tipo).slice(0, 3);
---
<Base title={`${d.titulo} · ${d.bairro} · ${brl(d.preco)} | Wisekey Imóveis`} description={desc} image={og.src} jsonld={jsonld} atual="imoveis" comFixo>
  <div class="faixa-w">
    <div class="faixa" aria-label="Fotos do imóvel. Arraste para o lado.">
      {d.fotos.map((f, i) => (
        <figure>
          <Image src={f} alt={d.legendas[i] || `Foto ${i + 1} de ${d.fotos.length}: ${d.titulo}`} widths={[480, 900, 1400]} sizes="(max-width: 900px) 90vw, 760px" loading={i < 2 ? 'eager' : 'lazy'} class={d.fotos_ilustrativas ? 'ilustra' : undefined} style={d.fotos_ilustrativas ? 'filter:grayscale(1)' : undefined} />
          {d.legendas[i] && <figcaption>{d.legendas[i]}</figcaption>}
        </figure>
      ))}
    </div>
    <span class="cont">{d.fotos.length} {d.fotos.length === 1 ? 'foto' : 'fotos'}{d.fotos.length > 1 ? ' · arraste' : ''}</span>
  </div>
  <div class="wrap">
    <div class="ficha">
      <div>
        <div class="trilha"><a href={u('/imoveis/')}>Imóveis</a> › {b ? <a href={u(`/bairros/${b.slug}/`)}>{d.bairro}</a> : d.bairro} › {d.codigo}</div>
        <h1>{d.titulo}</h1>
        <p class="cinza-t" style="margin-top:12px">{TIPO[d.tipo]} · {d.bairro}{d.condominio_nome ? ` · ${d.condominio_nome}` : ''} · São João da Boa Vista</p>
        <div class="numeros">
          {!ehTerreno && d.area_construida && <div><svg><use href="#i-area" /></svg><b>{m2(d.area_construida)}</b><span>área útil</span></div>}
          {d.area_terreno && <div><svg><use href="#i-terreno" /></svg><b>{m2(d.area_terreno)}</b><span>de terreno</span></div>}
          {d.quartos ? <div><svg><use href="#i-cama" /></svg><b>{d.quartos}</b><span>{d.quartos === 1 ? 'quarto' : 'quartos'}</span></div> : null}
          {d.suites ? <div><svg><use href="#i-suite" /></svg><b>{d.suites}</b><span>{d.suites === 1 ? 'suíte' : 'suítes'}</span></div> : null}
          {d.banheiros ? <div><svg><use href="#i-banho" /></svg><b>{d.banheiros}</b><span>{d.banheiros === 1 ? 'banheiro' : 'banheiros'}</span></div> : null}
          {d.vagas ? <div><svg><use href="#i-carro" /></svg><b>{d.vagas}</b><span>{d.vagas === 1 ? 'vaga' : 'vagas'}</span></div> : null}
        </div>

        <h2>Sobre o imóvel</h2>
        <Content />
        {d.destaques.length > 0 && <ul class="lista" style="margin-top:10px">{d.destaques.map((x) => <li>{x}</li>)}</ul>}

        {grupos.length > 0 && (
          <>
            <h2>Características</h2>
            <div class="carac">{grupos.map(([t, xs]) => <div><h4>{t}</h4><ul>{xs.map((x) => <li>{x}</li>)}</ul></div>)}</div>
          </>
        )}

        <h2>A conta deste imóvel</h2>
        <div class="conta">
          {c ? (
            <>
              <p style="margin:0">Sai a <b>{brl(c.valor)} por m²</b>. A mediana de {TIPO[d.tipo].toLowerCase()} no {c.bairro.nome} é {brl(c.tipo.m2_mediana)} por m², em {c.tipo.n} anúncios. <b style={`color:${corDif}`}>{rotuloDif}</b></p>
              <Regua p25={c.tipo.m2_p25} p75={c.tipo.m2_p75} mediana={c.tipo.m2_mediana} valor={c.valor} />
            </>
          ) : (
            <p style="margin:0">Ainda não há anúncios suficientes de {TIPO[d.tipo].toLowerCase()} no {d.bairro} para comparar com segurança.</p>
          )}
          {mensal > 0 && (
            <table class="custos">
              <caption class="sr">Custo mensal de manter o imóvel</caption>
              {d.condominio_mensal ? <tr><td>Condomínio</td><td>{brl(d.condominio_mensal)}/mês</td></tr> : null}
              {d.iptu_anual ? <tr><td>IPTU</td><td>{brl(d.iptu_anual / 12)}/mês</td></tr> : null}
              <tr><td>Para manter</td><td>{brl(mensal)}/mês</td></tr>
            </table>
          )}
        </div>
        <p class="nota" style="margin-top:14px">Preço de anúncio comparado com a rede parceira local (coleta de ago/2026). {d.laudo && 'Preço definido com laudo pelo método comparativo (NBR 14653). '}Endereço exato na visita. {site.creci_pj}.</p>

        <h2>Continue procurando</h2>
        <div class="links">
          {b && <a href={u(`/bairros/${b.slug}/`)}>Preço do m² no {b.nome}</a>}
          <a href={u(`/imoveis/?bairro=${encodeURIComponent(d.bairro)}`)}>Imóveis no {d.bairro}</a>
          <a href={u(`/imoveis/?tipo=${d.tipo}`)}>{TIPO[d.tipo]}s à venda</a>
        </div>
      </div>

      <aside>
        <div class="painel">
          <span class="nota">{d.demo ? 'Imóvel de exemplo · ' : ''}{STATUS[d.status]} · código {d.codigo}</span>
          <p class="valor">{brl(d.preco)}</p>
          {mensal > 0 && <span class="nota">+ {brl(mensal)}/mês {rotuloMensal}</span>}
          <a class="btn" href={wa(msgVisita)} style="margin-top:12px"><svg><use href="#i-wa" /></svg>Quero visitar</a>
          <a class="btn cont" href={wa(msgDuvida)}>Tirar uma dúvida</a>
          <a class="btn cont" href={`https://wa.me/?text=${encodeURIComponent(`${d.titulo}, ${brl(d.preco)}: ${url}`)}`}>Mandar para alguém</a>
        </div>
      </aside>
    </div>
  </div>
  {outros.length > 0 && (
    <section class="sec cinza">
      <div class="wrap">
        <h2 class="titulo menor" style="margin-bottom:32px">Veja também</h2>
        <div class="grade">{outros.map((i) => <CardImovel imovel={i} />)}</div>
      </div>
    </section>
  )}
  <div class="fixo-wa"><a class="btn" href={wa(msgVisita)}>Quero visitar · {brl(d.preco)}</a></div>
</Base>
